{
    "name": "@riaskov/mmap-io",
    "version": "1.6.0",
    "license": "MIT",
    "author": {
        "name": "Oscar Campbell",
        "email": "oscar@campbell.nu",
        "url": "https://github.com/ozra"
    },
    "contributors": [
        {
          "name": "Nick Johnstone",
          "url": "https://github.com/Widdershin"
        },
        {
          "name": "Andrei Riaskov",
          "email": "code@riaskov.com"
        }
    ],
    "binary": {
        "module_name": "mmap_io",
        "module_path": "./build/binding/{configuration}/{node_abi}-{platform}-{arch}/",
        "remote_path": "./v{version}/",
        "package_name": "{module_name}-v{version}-{node_abi}-{platform}-{arch}.tar.gz",
        "host": "https://github.com/ARyaskov/mmap-io/releases/download/"
    },
    "description": "Node.js mmap bindings revisited.",
    "homepage": "https://github.com/ARyaskov/mmap-io",
    "keywords": [
        "low level",
        "file",
        "memory mapped",
        "mmap",
        "advise",
        "sync",
        "shared memory",
        "C++",
        "performance"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/ARyaskov/mmap-io.git"
    },
    "bugs": {
        "url": "http://github.com/ARyaskov/mmap-io/issues"
    },
    "main": "mmap-io.js",
    "types": "mmap-io.d.ts",
    "engines": {
        "node": ">=18.17.0"
    },
    "packageManager": "pnpm@10.34.5",
    "files": [
        "binding.gyp",
        "LICENSE",
        "dist",
        "mmap-io.d.ts",
        "mmap-io.js",
        "package.json",
        "README.md",
        "src"
    ],
    "scripts": {
        "clean": "node -e \"const fs=require('node:fs'); for (const d of ['build','dist']) fs.rmSync(d,{recursive:true,force:true})\"",
        "build": "npm run build-native && npm run build-ts",
        "build-native": "node-pre-gyp install --fallback-to-build",
        "build-ts": "tsc --project tsconfig.build.json && node -e \"require('node:fs').copyFileSync('dist/mmap-io.d.ts','mmap-io.d.ts')\"",
        "build-addon": "npm run build-native",
        "build-es": "npm run build-ts",
        "rebuild": "node-pre-gyp rebuild --build-from-source",
        "package-binary": "node-pre-gyp package",
        "install": "node-pre-gyp install --fallback-to-build",
        "prepare": "npm run build-ts",
        "test": "node --test",
        "typecheck": "tsc --project tsconfig.json --noEmit"
    },
    "dependencies": {
        "@mapbox/node-pre-gyp": "^2.0.3",
        "nan": "^2.28.0",
        "node-gyp": "^11.5.0"
    },
    "devDependencies": {
        "@types/node": "^22.20.1",
        "typescript": "^5.9.3"
    }
}
