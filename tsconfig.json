{
  "compilerOptions": {
    /* ES2022 is the newest level Node 18 - the oldest runtime this package
       supports - can execute without downlevelling. */
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "types": ["node"],

    "declaration": true,
    "outDir": "./dist/",
    "rootDir": "./src/",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  /* Everything under src/ is type-checked; see tsconfig.build.json for what
     actually gets emitted into dist/. */
  "include": ["src/**/*.ts"]
}
